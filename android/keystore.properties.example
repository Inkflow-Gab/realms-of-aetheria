# ============================================
# SIGNING CONFIGURATION TEMPLATE
# ============================================
#
# Copy to keystore.properties in this same folder and fill in real values:
#
#   cp keystore.properties.example keystore.properties
#
# Generate a keystore (valid ~30 years):
#
#   keytool -genkeypair -v \
#     -keystore keystore.jks -storetype PKCS12 \
#     -alias realms-of-aetheria \
#     -keyalg RSA -keysize 4096 -validity 10950
#
# BACK THE KEYSTORE UP SOMEWHERE SAFE.
# Android identifies an app by its signing key. Lose this file and you can
# never publish an update to your existing install -- you would have to
# change the applicationId and ship a brand new app.
# ============================================

storeFile=keystore.jks
storePassword=CHANGE_ME
keyAlias=realms-of-aetheria
keyPassword=CHANGE_ME
