{
  "name": "realms-of-aetheria",
  "version": "1.0.4",
  "description": "Realms of Aetheria - A Full Mobile RPG",
  "main": "index.js",
  "scripts": {
    "start": "npx serve . -p 8080",
    "generate:embedded": "node scripts/generate-embedded.js",
    "build": "npm run generate:embedded && node scripts/prepare-web.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "cap:android": "npx cap open android",
    "test": "node scripts/test-loader.js",
    "verify": "npm run build && npm test"
  },
  "keywords": ["rpg", "game", "mobile", "phaser", "capacitor"],
  "author": "Gab",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/app": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
