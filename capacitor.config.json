{
  "appId": "com.aetheria.realms",
  "appName": "Realms of Aetheria",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0a1a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0a1a"
  }
}
